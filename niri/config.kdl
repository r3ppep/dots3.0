// autostart
spawn-sh-at-startup "noctalia"
spawn-sh-at-startup "xwayland-satellite"
// display

output "DP-2" {
    mode "2560x1440@143.972" // Set resolution and refresh rate
    scale 1 // No scaling (use 2 for HiDPI)
}
output "DP-3" {
    mode "2560x1440@164.802" // Set resolution and refresh rate
}

// input

input {
    keyboard {
        xkb {
        layout "de"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
    
    mouse {
        // off
        // natural-scroll
        // accel-speed 0.0
        accel-profile "flat"
        // scroll-factor 1.0
        // scroll-factor vertical=1.0 horizontal=-2.0
        // scroll-method "no-scroll"
        // scroll-button 273
        // scroll-button-lock
        // left-handed
    }


    //focus-follows-mouse  // Focus windows and outputs automatically when moving the mouse into them.
    workspace-auto-back-and-forth // Enable Workspace back & forth switching
}

// keybinds

binds {

    // Mod+Shift+Escape            { show-hotkey-overlay; }

    // Applications and Noctalia
    Mod+Return hotkey-overlay-title="Open Terminal: Kitty" { spawn "kitty"; }
    Mod+Space hotkey-overlay-title="Open App Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+V hotkey-overlay-title="File Manager" { spawn "nautilus"; }
    Mod+Escape { quit; }
    Mod+Shift+Escape { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+C { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Shift+N { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Ctrl+S { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Ctrl+R { spawn-sh "noctalia msg plugin noctalia/screen_recorder:service all toggle portal"; }
    Mod+Shift+R { spawn-sh "noctalia msg plugin noctalia/screen_recorder:service all toggle focused"; }

    // Screenshots
    Mod+S { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Shift+S { spawn "noctalia" "msg" "screenshot-fullscreen"; }

    // Media
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true repeat=false { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioPlay allow-when-locked=true repeat=false { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // Window and workspace actions
    Mod+Q repeat=false { close-window; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+MouseForward { set-column-width "-20%"; }
    Mod+MouseBack { set-column-width "+20%"; }
    Mod+T repeat=false { toggle-window-floating; }
    Mod+Shift+T repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+M { maximize-window-to-edges; }
    Mod+F { fullscreen-window; }
    Mod+Ctrl+F { maximize-column; }
    Mod+R { switch-preset-column-width; }
    Mod+W repeat=false { toggle-column-tabbed-display; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Alt+Up { move-column-to-workspace-up; }
    Mod+Alt+Down { move-column-to-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // Niri has no direct equivalents for pinned windows or scratchpad actions.
    // Keep the existing Mod+Tab and Mod+Space behavior in their place.
    Mod+Tab { focus-workspace-previous; }

    // Additional existing Niri bindings
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Shift+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Ctrl+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Alt+P { power-off-monitors; }
}

// layout


layout {
	gaps 5
	center-focused-column "never"
	always-center-single-column
	// background-color "#191724"
	background-color "transparent"

	preset-column-widths {
		proportion 0.25
		proportion 0.5
		proportion 0.75
		proportion 1.0
	}

	default-column-width {
		proportion 0.5
	}

	focus-ring {
		on
		width 1
		active-color "#c061cb"
		// urgent-color "#eb6f92"
	}

	border {
		off
		width 3
		active-color "#ebbcba"
		inactive-color "#191724"
		urgent-color "#eb6f92"
	}

	shadow {
		on
		softness 20
		spread 3
		offset x=0 y=0
		draw-behind-window false
		color "#00000070"
	}

	//struts {
		// top 23
		// left 23
		// right 23
		// bottom 23
		//bottom -6
	//}
}

// Environment and Miscellaneous Settings

    prefer-no-csd
    screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

    environment {
	MOZ_ENABLE_WAYLAND "1"
	PROTON_ENABLE_WAYLAND "1"
	OZONE_PLATFORM "wayland"
	ELECTRON_OZONE_PLATFORM_HINT "wayland"

	SDL_VIDEODRIVER "wayland"
	SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY "1"
	GDK_BACKEND "wayland,x11,*"
	CLUTTER_BACKEND "wayland"

		// QT
	QT_QPA_PLATFORM "wayland"
	QT_QPA_PLATFORMTHEME "qt6ct"
	QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    }

    debug {
        // Allows notification actions and window activation from Noctalia.
        honor-xdg-activation-with-invalid-serial
    }

    hotkey-overlay {
       skip-at-startup
    }


// rules

//layer-rule {
//    match namespace="^quickshell-overview$"
//   place-within-backdrop true
//}


////////////////////////////////////////////////////////////////////////////////////

//window-rule {
//	match is-active=false
//
//	opacity 1
//}
//General Rules
window-rule {
	geometry-corner-radius 10
	clip-to-geometry true
    opacity 0.95
	background-effect {
		blur true
		xray false
	}
}

//Application Specific Rules
window-rule {
    match app-id="Nautilus"
    opacity 0.95
    background-effect {
      blur true
      xray true
    }
}

window-rule {
    match app-id="Codium|Zed"
    opacity 1.0
}

window-rule {
    match app-id="firefox|floorp|^.*zen$|chromium-browser|librewolf"
    opacity 1.0
}


// noctalia settings
window-rule {
	match app-id="dev.noctalia.Noctalia"

	default-column-width { proportion 0.8; }
	default-window-height { proportion 0.9; }

	open-floating true
}

// Picture-in-Picture
window-rule {
	match app-id="firefox|floorp|^.*zen$|chromium-browser|librewolf" title="Picture-in-Picture"

	default-column-width { fixed 354; }
	default-window-height { fixed 200; }

	default-floating-position x=20 y=20 relative-to="bottom-right"

	open-focused false

	border { off; }
}

layer-rule {
	match namespace="^noctalia-.*$"

	background-effect {
		xray false
	}
}

layer-rule {
	match namespace="^noctalia-backdrop"
	place-within-backdrop true
}