// autostart
spawn-sh-at-startup "noctalia"

// display

output "DP-2" {
    mode "2560x1440@143.980" // Set resolution and refresh rate
    scale 1 // No scaling (use 2 for HiDPI)
}
output "DP-3" {
    mode "2560x1440@164.802" // Set resolution and refresh rate
}

// input

input {
    keyboard {
        xkb {
        layout "de"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
    
    mouse {
        // off
        // natural-scroll
        accel-speed 0.0
        accel-profile "flat"
        // scroll-factor 1.0
        // scroll-factor vertical=1.0 horizontal=-2.0
        // scroll-method "no-scroll"
        // scroll-button 273
        // scroll-button-lock
        // left-handed
    }


    focus-follows-mouse  // Focus windows and outputs automatically when moving the mouse into them.
    workspace-auto-back-and-forth // Enable Workspace back & forth switching
}

// keybinds

binds {

    Mod+Shift+Escape            { show-hotkey-overlay; }

    //Apps//
    Mod+Return             hotkey-overlay-title="Open Terminal: Kitty" { spawn "kitty"; }
    MOD+space              hotkey-overlay-title="Open App Launcher" { spawn-sh "noctalia msg panel-toggle launcher";}
    // MOD+B               hotkey-overlay-title="Open Browser" { spawn "brave"; }


    // File Manager //
    MOD+V               hotkey-overlay-title="File Manager" { spawn "nautilus"; }

    // Audio Controls //

    XF86AudioRaiseVolume allow-when-locked=true       { spawn "noctalia" "msg" "volume-up" "2"; }
	XF86AudioLowerVolume allow-when-locked=true       { spawn "noctalia" "msg" "volume-down" "2"; }
	XF86AudioMute allow-when-locked=true repeat=false { spawn "noctalia" "msg" "volume-mute"; }
	XF86MonBrightnessUp allow-when-locked=true        {	spawn "noctalia" "msg" "brightness-up" "5%"; }
	XF86MonBrightnessDown allow-when-locked=true      { spawn "noctalia" "msg" "brightness-down" "5%"; }
	XF86AudioPlay allow-when-locked=true repeat=false { spawn "noctalia" "msg" "media" "toggle"; }

    // Window Movement //
    MOD+Q               { close-window; }

    MOD+LEFT            { focus-column-left; }
    MOD+RIGHT           { focus-column-right; }
    MOD+UP              { focus-window-up; }
    MOD+DOWN            { focus-window-down; }

    MOD+SHIFT+LEFT       { move-column-left; }
    MOD+SHIFT+RIGHT      { move-column-right; }
    MOD+CTRL+UP         { move-window-up; }
    MOD+CTRL+DOWN       { move-window-down; }

    MOD+HOME            { focus-column-first; }
    MOD+END             { focus-column-last; }
    MOD+CTRL+HOME       { move-column-to-first; }
    MOD+CTRL+END        { move-column-to-last; }

    // MOD+SHIFT+LEFT      { focus-monitor-left; }
    // MOD+SHIFT+RIGHT     { focus-monitor-right; }
    // MOD+SHIFT+UP        { focus-monitor-up; }
    // MOD+SHIFT+DOWN      { focus-monitor-down; }

    MOD+SHIFT+CTRL+LEFT { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+RIGHT{ move-column-to-monitor-right; }
    

    // Workspace Switchting //
    MOD+WHEELSCROLLDOWN cooldown-ms=150 { focus-workspace-down; }
    MOD+WHEELSCROLLUP   cooldown-ms=150 { focus-workspace-up; }
    
    MOD+1                { focus-workspace 1; }
    MOD+2                { focus-workspace 2; }
    MOD+3                { focus-workspace 3; }
    MOD+4                { focus-workspace 4; }
    MOD+5                { focus-workspace 5; }
    MOD+6                { focus-workspace 6; }
    MOD+7                { focus-workspace 7; }
    MOD+8                { focus-workspace 8; }
    MOD+9                { focus-workspace 9; }

    MOD+CTRL+1          { move-column-to-workspace 1; }
    MOD+CTRL+2          { move-column-to-workspace 2; }
    MOD+CTRL+3          { move-column-to-workspace 3; }
    MOD+CTRL+4          { move-column-to-workspace 4; }
    MOD+CTRL+5          { move-column-to-workspace 5; }
    MOD+CTRL+6          { move-column-to-workspace 6; }
    MOD+CTRL+7          { move-column-to-workspace 7; }
    MOD+CTRL+8          { move-column-to-workspace 8; }
    MOD+CTRL+9          { move-column-to-workspace 9; }

    MOD+TAB             { focus-workspace-previous; }
    
    // Layout Controls //
    MOD+SHIFT+F                         { expand-column-to-available-width; }
    MOD+C                               { center-column; }
    MOD+CTRL+C                          { center-visible-columns; }
    MOD+MINUS                           { set-column-width "-10%"; }
    MOD+EQUAL                           { set-column-width "+10%"; }
    MOD+SHIFT+MINUS                     { set-window-height "-10%"; }
    MOD+SHIFT+EQUAL                     { set-window-height "+10%"; }

    // Modes //
    MOD+T                               { toggle-window-floating; }
    MOD+F                               { fullscreen-window; }
    MOD+W                               { maximize-column; }

    // Screenshots //
    Mod+Shift+S { screenshot show-pointer=false; }
    // MOD+SHIFT+F                         { screenshot-screen; }
    // MOD+SHIFT+A                         { screenshot-window; }

    // Emergency Escape Key //
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    MOD+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    
    // Exit / Power //
    CTRL+ALT+DELETE                     { quit; } // Also quits Niri
    MOD+SHIFT+P                         { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    MOD+O                               repeat=false { toggle-overview; }


}

// layout


layout {
	gaps 10
	center-focused-column "never"
	always-center-single-column
	// background-color "#191724"
	background-color "transparent"

	preset-column-widths {
		proportion 0.25
		proportion 0.5
		proportion 0.75
		proportion 1.0
	}

	default-column-width {
		proportion 0.5
	}

	focus-ring {
		off
		// width 3
		// active-color "#ebbcba"
		// urgent-color "#eb6f92"
	}

	border {
		off
		width 3
		active-color "#ebbcba"
		inactive-color "#191724"
		urgent-color "#eb6f92"
	}

	shadow {
		on
		softness 25
		spread 3
		offset x=0 y=0
		draw-behind-window true
		color "#00000070"
	}

	struts {
		// top 23
		// left 23
		// right 23
		// bottom 23
		bottom -6
	}
}

// misc

    prefer-no-csd
    screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

    environment {
	MOZ_ENABLE_WAYLAND "1"
	PROTON_ENABLE_WAYLAND "1"
	OZONE_PLATFORM "wayland"
	ELECTRON_OZONE_PLATFORM_HINT "wayland"

	SDL_VIDEODRIVER "wayland"
	SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY "1"
	GDK_BACKEND "wayland,x11,*"
	CLUTTER_BACKEND "wayland"

		// Java
	_JAVA_AWT_WM_NONREPARENTING "1"
	NO_AT_BRIDGE "1"

		// QT
	QT_QPA_PLATFORM "wayland"
	QT_QPA_PLATFORMTHEME "qt6ct"
	QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    }

    debug {
        // Allows notification actions and window activation from Noctalia.
        honor-xdg-activation-with-invalid-serial
    }

    hotkey-overlay {
       skip-at-startup
    }


// rules

window-rule {
    geometry-corner-radius 15
    clip-to-geometry true
}

//layer-rule {
//    match namespace="^quickshell-overview$"
//   place-within-backdrop true
//}

// noctalia settings
window-rule {
	match app-id="dev.noctalia.Noctalia"

	default-column-width { proportion 0.8; }
	default-window-height { proportion 0.9; }

	open-floating true
}

// Picture-in-Picture
window-rule {
	match app-id="firefox|floorp|^.*zen$|chromium-browser|librewolf" title="Picture-in-Picture"

	default-column-width { fixed 354; }
	default-window-height { fixed 200; }

	default-floating-position x=20 y=20 relative-to="bottom-right"

	open-focused false

	border { off; }
}

// default-column-width default-window-height open-floating true
window-rule {
	match app-id="^xdg-desktop-portal-gtk$|Electron"
	match app-id="^.*Nautilus$" title="^Open File.*$"
	match app-id="Electron" title="Save"
	match title="^dialog.*$|^All Files$|^confirm.*$|^Save As.*$|^Save Image.*$|^Open Folder.*$|^File Upload.*$|^Select.*$|^Choose wallpaper.*$|^Choose an image.*$|Choose File|Save Screenshot|^Locate ISO.*$|^blob.*$|Open project|datapacks|^(.*)//account.proton.me/(.*)$|Choose photolan|^Find Java.*$|^Choose Projectless.*$"

	default-column-width { proportion 0.5; }
	default-window-height { proportion 0.5; }

	open-floating true
}

// steam / games
window-rule {
	match app-id="steam" title="^Sign in.*$"

	open-floating true
	
	default-floating-position x=-83 y=132 relative-to="right"
}

window-rule {
	match app-id="steam" title="Shutdown"

	open-floating true

	default-floating-position x=0 y=72 relative-to="right"
}

window-rule {
	match app-id="steam" title="^.*Dialog$"

	open-floating true

	default-floating-position x=290 y=53.5 relative-to="right"
}

window-rule {
	match app-id="steam" title="Launching..."

	default-floating-position x=44 y=74 relative-to="right"
}

window-rule {
	match app-id="steam" title="Friends List"

	default-column-width { proportion 0.2; }
	default-window-height { proportion 0.5; }

	default-floating-position x=24 y=24 relative-to="bottom-right"
}

window-rule {
	match is-active=false

	opacity 0.87
}

window-rule {
	geometry-corner-radius 12
	clip-to-geometry true

	background-effect {
		blur true
		xray false
	}
}

layer-rule {
	match namespace="^noctalia-.*$"

	background-effect {
		xray false
	}
}

layer-rule {
	match namespace="^noctalia-backdrop"
	place-within-backdrop true
}

