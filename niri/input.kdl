input {
    keyboard {
        xkb {
        layout "de"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
    
    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        accel-profile "flat"
        // scroll-factor 1.0
        // scroll-factor vertical=1.0 horizontal=-2.0
        // scroll-method "no-scroll"
        // scroll-button 273
        // scroll-button-lock
        // left-handed
        // middle-emulation
    }


    focus-follows-mouse  // Focus windows and outputs automatically when moving the mouse into them.
    workspace-auto-back-and-forth // Enable Workspace back & forth switching
}